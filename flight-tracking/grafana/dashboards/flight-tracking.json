{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Real-time aircraft tracking from OpenSky Network. Geomap of aircraft positions with altitude and velocity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "basemap": { "name": "Basemap", "type": "default" },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "name": "Aircraft",
            "type": "markers",
            "tooltip": true,
            "config": {
              "showLegend": true,
              "style": {
                "color": { "field": "baro_altitude", "fixed": "dark-blue" },
                "opacity": 0.85,
                "rotation": { "field": "true_track", "fixed": 0, "max": 360, "min": -360, "mode": "field" },
                "size": { "field": "baro_altitude", "fixed": 8, "max": 16, "min": 4 },
                "symbol": { "fixed": "img/icons/airport.svg", "mode": "fixed" },
                "text": { "field": "icao24", "fixed": "", "mode": "field" },
                "textConfig": { "fontSize": 9, "offsetX": 0, "offsetY": -8, "textAlign": "center", "textBaseline": "bottom" }
              }
            },
            "location": { "mode": "coords", "latitude": "lat", "longitude": "lon" }
          }
        ],
        "tooltip": { "mode": "details" },
        "view": { "id": "zero", "lat": 20, "lon": 0, "zoom": 1.3 }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "table",
          "query": "SELECT\n  last(\"lat\") AS \"lat\",\n  last(\"lon\") AS \"lon\",\n  last(\"baro_altitude\") AS \"baro_altitude\",\n  last(\"true_track\") AS \"true_track\",\n  last(\"velocity\") AS \"velocity\"\nFROM \"aircraft_state\"\nWHERE $timeFilter\nGROUP BY \"icao24\"\nSLIMIT 500"
        }
      ],
      "title": "Aircraft Positions",
      "type": "geomap"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "m/s",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "mps"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "alias": "$tag_icao24",
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "groupBy": [
            { "params": ["$__interval"], "type": "time" },
            { "params": ["icao24"], "type": "tag" },
            { "params": ["null"], "type": "fill" }
          ],
          "measurement": "aircraft_state",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [[{ "params": ["velocity"], "type": "field" }, { "params": [], "type": "mean" }]],
          "tags": []
        }
      ],
      "title": "Velocity by Aircraft",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "m",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "length"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "alias": "$tag_icao24",
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "groupBy": [
            { "params": ["$__interval"], "type": "time" },
            { "params": ["icao24"], "type": "tag" },
            { "params": ["null"], "type": "fill" }
          ],
          "measurement": "aircraft_state",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [[{ "params": ["baro_altitude"], "type": "field" }, { "params": [], "type": "mean" }]],
          "tags": []
        }
      ],
      "title": "Altitude by Aircraft",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "lat" },
            "properties": [{ "id": "unit", "value": "decimalDegree" }, { "id": "decimals", "value": 4 }]
          },
          {
            "matcher": { "id": "byName", "options": "lon" },
            "properties": [{ "id": "unit", "value": "decimalDegree" }, { "id": "decimals", "value": 4 }]
          },
          {
            "matcher": { "id": "byName", "options": "velocity" },
            "properties": [{ "id": "unit", "value": "mps" }]
          },
          {
            "matcher": { "id": "byName", "options": "baro_altitude" },
            "properties": [{ "id": "unit", "value": "length" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "icao24" }]
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "groupBy": [{ "params": ["icao24"], "type": "tag" }, { "params": ["callsign"], "type": "tag" }, { "params": ["origin_country"], "type": "tag" }],
          "measurement": "aircraft_state",
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT\n  last(\"lat\") AS \"lat\",\n  last(\"lon\") AS \"lon\",\n  last(\"baro_altitude\") AS \"baro_altitude\",\n  last(\"velocity\") AS \"velocity\",\n  last(\"true_track\") AS \"true_track\"\nFROM \"aircraft_state\"\nWHERE $timeFilter\nGROUP BY \"icao24\", \"callsign\", \"origin_country\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "table",
          "select": [[{ "params": ["lat"], "type": "field" }, { "params": [], "type": "last" }]],
          "tags": []
        }
      ],
      "title": "Latest Aircraft Positions",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {
              "icao24": "ICAO24",
              "callsign": "Callsign",
              "origin_country": "Country",
              "lat": "Latitude",
              "lon": "Longitude",
              "baro_altitude": "Altitude (m)",
              "velocity": "Speed (m/s)",
              "true_track": "Heading (deg)"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["flight", "tracking", "hyperbytedb"],
  "templating": {
    "list": [
      {
        "current": { "text": "Flight Tracking", "value": "Flight Tracking" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "influxdb",
        "refresh": 1,
        "regex": "Flight Tracking",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Flight Tracking",
  "uid": "flight-tracking",
  "version": 1,
  "weekStart": ""
}
