        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT mean(\"cpu\") AS \"Server CPU\" FROM \"server_stats\" WHERE \"region\" =~ /^$region$/ AND \"server_id\" =~ /^$server_id$/ AND \"machine_id\" =~ /^$machine_id$/ AND $timeFilter GROUP BY time(1m), \"machine_id\" fill(null)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "alias": "avg server cpu"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT mean(\"user\") + mean(\"sys\") AS \"Host CPU\" FROM \"machine_stats\" WHERE \"region\" =~ /^$region$/ AND \"machine_id\" =~ /^$machine_id$/ AND $timeFilter GROUP BY time(1m), \"machine_id\" fill(null)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series",
          "alias": "host cpu"
        }
      ],
      "title": "Server vs host CPU correlation",
      "type": "timeseries",
      "description": ""
    }
  ],
